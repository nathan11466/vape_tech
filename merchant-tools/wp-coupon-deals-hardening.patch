 	/**
+	 * A quota rather than a cooldown: at most $max events per $window.
+	 *
+	 * rate_limit_ok() only enforces a gap between events, which a script
+	 * defeats by waiting. Anything that writes a number readers are shown
+	 * needs a ceiling as well.
+	 */
+	private static function quota_ok( $key, $max, $window ) {
+		$transient = 'wcd_q_' . md5( $key );
+		$used = (int) get_transient( $transient );
+		if ( $used >= $max ) { return false; }
+		// Keep the original window: re-setting it on every event would let a
+		// steady trickle hold the counter open indefinitely.
+		set_transient( $transient, $used + 1, $window );
+		return true;
+	}
+
+	/**
+	 * Whether a displayed counter may be incremented for this caller.
+	 *
+	 * Deliberately separate from whether the request succeeds. A reader
+	 * opening the same coupon ten times should get the code every time and
+	 * count once -- the number on the card is a claim about other people.
+	 */
+	private static function may_count( $post_id ) {
+		$key = 'wcd_cnt_' . md5( self::caller_key( 'count_' . $post_id ) );
+		if ( get_transient( $key ) ) { return false; }
+		set_transient( $key, 1, HOUR_IN_SECONDS );
+		return true;
+	}
